        """
        # Implementation reads AZURE_CLIENT_ID, AZURE_CLIENT_SECRET, AZURE_TENANT_ID
        # from environment variables and returns ClientSecretCredential
        pass
    
    def _get_metrics_client(self, location: str):
        """
        Get or create metrics client (lazy initialization).
        
        Args:
            location: Azure resource location (e.g., 'westeurope', 'eastus')
            
        Returns:
            MetricsClient: Authenticated metrics client
        """
        # Implementation uses MonitorUtils.get_metrics_endpoint(location) to get endpoint
        # Creates MetricsClient with endpoint and credentials
        # Uses lazy initialization - creates client only once
        pass
    
    @staticmethod
    def build_resource_id(config: Dict[str, Any]) -> str:
        """
        Build Azure resource ID from configuration.
        
        Args:
            config: Configuration dictionary containing:
                - resource_type: str
                - subscription_id: str
                - resource_group: str
                - resource_name: str
        
        Returns:
            Full Azure resource ID string
        
        Raises:
            ConfigValidationError: If resource_type is unsupported or required fields are missing
        """
        # Implementation should use config_validator.build_resource_id()
        pass
    
    def _extract_problems(
        self,
        breakdown_dict: Dict[str, float],
        metadata_key: str,
        warn_threshold: Optional[float],
        crit_threshold: Optional[float]
    ) -> List[MetricProblem]:
