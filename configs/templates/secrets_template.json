{
  "resource_type": "secrets",
  "location": "polandcentral",
  "service_name": "Azure App Registration Secrets",
  "app_registrations": [
    {
      "app_id": "<application-client-id>",
      "app_name": null
    }
  ],
  "metrics": {
    "secret_expiration_days": {
      "type": "secrets",
      "enabled": true,
      "expiration_threshold": 60
    },
    "certificate_expiration_days": {
      "type": "certificates",
      "enabled": true,
      "expiration_threshold": 60
    }
  }
}

