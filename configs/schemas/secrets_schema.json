{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["resource_type", "location", "app_registrations", "metrics"],
  "properties": {
    "resource_type": {
      "type": "string",
      "enum": ["secrets"]
    },
    "location": {
      "type": "string",
      "description": "Azure location/region"
    },
    "app_registrations": {
      "type": "array",
      "items": {
        "type": "object",
        "oneOf": [
          {
            "properties": {
              "app_id": {
                "type": "string"
              },
              "app_name": {
                "type": "null"
              }
            },
            "required": ["app_id"],
            "additionalProperties": false
          },
          {
            "properties": {
              "app_id": {
                "type": "null"
              },
              "app_name": {
                "type": "string"
              }
            },
            "required": ["app_name"],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1
    },
    "metrics": {
      "type": "object",
      "patternProperties": {
        ".*": {
          "$ref": "#/definitions/expirationMetricConfig"
        }
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "expirationMetricConfig": {
      "type": "object",
      "required": ["enabled", "type", "expiration_threshold"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "enum": ["secrets", "certificates"],
          "$comment": "Available values: secrets, certificates"
        },
        "expiration_threshold": {
          "type": "number",
          "minimum": 0,
          "description": "Number of days until expiration threshold. Applications with secrets/certificates expiring within this threshold are counted."
        }
      },
      "additionalProperties": false
    }
  }
}

