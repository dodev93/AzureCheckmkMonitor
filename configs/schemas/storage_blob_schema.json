{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["resource_type", "subscription_id", "resource_group", "resource_name", "location", "container_name", "metrics"],
  "properties": {
    "resource_type": {
      "type": "string",
      "enum": ["storage_blob"]
    },
    "subscription_id": {
      "type": "string",
      "description": "Azure subscription ID"
    },
    "resource_group": {
      "type": "string",
      "description": "Resource group name"
    },
    "resource_name": {
      "type": "string",
      "description": "Storage account name"
    },
    "container_name": {
      "type": "string"
    },
    "location": {
      "type": "string",
      "description": "Azure location/region"
    },
    "service_name": {
      "type": "string",
      "description": "Service name that will be returned in CheckMK response"
    },
    "time_range": {
      "type": "string",
      "pattern": "^PT\\d+[MHD]$",
      "description": "ISO 8601 duration format used for both time range and granularity (e.g., PT1H, PT5M)"
    },
    "aggregation": {
      "type": "string",
      "enum": ["average", "sum", "count", "min", "max"],
      "$comment": "Available values: average, sum, count, min, max",
      "description": "Aggregation type applied to all metrics unless overridden"
    },
    "metrics": {
      "type": "object",
      "patternProperties": {
        "^.+$": {
          "oneOf": [
            {"$ref": "#/definitions/fileExistenceConfig"},
            {"$ref": "#/definitions/fileModificationConfig"}
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "fileExistenceConfig": {
      "type": "object",
      "required": ["enabled", "type"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "enum": ["file_existence"],
          "description": "Metric type identifier"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "missing_status": {
          "type": "string",
          "enum": ["OK", "WARN", "CRIT", "UNKNOWN"],
          "$comment": "Available values: OK, WARN, CRIT, UNKNOWN"
        }
      },
      "additionalProperties": false
    },
    "fileModificationConfig": {
      "type": "object",
      "required": ["enabled", "type"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "enum": ["file_modification"],
          "description": "Metric type identifier"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "max_hours_since_modification": {
          "type": "number",
          "minimum": 0
        },
        "exceeded_status": {
          "type": "string",
          "enum": ["OK", "WARN", "CRIT", "UNKNOWN"],
          "$comment": "Available values: OK, WARN, CRIT, UNKNOWN"
        }
      },
      "additionalProperties": false
    }
  }
}

